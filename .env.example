# Environment for app.batchlabel.xyz. Copy to .env.local for development, and set
# the same values in the Vercel project for preview and production.
#
# There are no secrets here. The anon key is public by design: every table is
# behind row level security, and brand_memberships in particular grants a user
# SELECT on their own row and grants nobody INSERT or UPDATE. Entitlements are
# written server-side only, by the marketing site's Stripe webhook.

# Supabase. Must be the SAME project as the marketing site — the shared session
# cookie is named after the project ref, so a different project means a different
# cookie name and the session will not carry between www and app.
VITE_SUPABASE_URL=https://cqzrwfresuiktgzhkhok.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where an unauthenticated visitor is sent to sign in, and where sign-out returns
# to. Point this at a preview deployment of the marketing site when testing one.
VITE_MARKETING_URL=https://www.batchlabel.xyz

# Which Orchestrate sub-brand's membership row this app reads. Must match the
# marketing site's VITE_ORCHESTRATE_BRAND, or a signed-in user will have an
# entitlement that this app cannot see.
VITE_ORCHESTRATE_BRAND=batchlabel

# The Meta Pixel (dataset) id. Public by design: it ships inside the page and
# anyone can read it out of the network tab, which is why it is VITE_ prefixed
# and why that is safe. Must be the SAME id as the marketing site's, so the app's
# InitiateCheckout lands in the same dataset as www's events.
#
# The Conversions API access token is the opposite of this and does NOT belong in
# this repo at all — it is server-only, on the marketing site. See
# docs/META_TRACKING.md.
#
# Leave it unset and no Pixel is loaded and nothing is sent, whatever any consent
# flag says.
VITE_META_PIXEL_ID=1374342861305621

# Loads the Pixel on localhost so events can be checked in Meta's Test Events
# tool without deploying. Off unless the value is exactly "true". Never set it in
# a Vercel environment: development would report into the live dataset.
# VITE_META_PIXEL_DEBUG=true
