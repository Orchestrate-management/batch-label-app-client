# Environment for app.batchlabel.xyz. Copy to .env.local for development, and set
# the same values in the Vercel project for preview and production.
#
# There are no secrets here. The anon key is public by design: every table is
# behind row level security, and brand_memberships in particular grants a user
# SELECT on their own row and grants nobody INSERT or UPDATE. Entitlements are
# written server-side only, by the marketing site's Stripe webhook.

# Supabase. Must be the SAME project as the marketing site — the shared session
# cookie is named after the project ref, so a different project means a different
# cookie name and the session will not carry between www and app.
VITE_SUPABASE_URL=https://cqzrwfresuiktgzhkhok.supabase.co
VITE_SUPABASE_ANON_KEY=

# Where an unauthenticated visitor is sent to sign in, where sign-out returns to,
# AND the origin the billing endpoints are called on: /api/plans,
# /api/create-checkout-session and /api/create-portal-session all live there,
# because the Stripe secret key and the plan contract cannot be in this bundle.
#
# Point this at a preview deployment of the marketing site when testing one — and
# note that the preview origin of THIS app must also be added to
# STRIPE_ALLOWED_ORIGINS on the marketing project, or every billing call is
# CORS-blocked in the browser with nothing in the server logs.
VITE_MARKETING_URL=https://www.batchlabel.xyz

# Which Orchestrate sub-brand's membership row this app reads. Must match the
# marketing site's VITE_ORCHESTRATE_BRAND, or a signed-in user will have an
# entitlement that this app cannot see.
VITE_ORCHESTRATE_BRAND=batchlabel
